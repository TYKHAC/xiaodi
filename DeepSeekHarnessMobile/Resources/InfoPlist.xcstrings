{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "Hestia"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "Hestia"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zhu Xiaojie uses the camera to take photos and to scan pairing QR codes generated by the desktop app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "拍照发给Hestia，或扫描电脑端生成的配对二维码。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Connects to the Zhu Xiaojie desktop gateway over your network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "连接Hestia的电脑端网关（同一网络或远程虚拟网络）。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - Location Always and When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While an Agent is running, Zhu Xiaojie uses low-accuracy background location to keep the task connected. Location data is never stored or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 执行期间使用低精度后台定位维持任务连接；位置数据不会保存或上传。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While an Agent is running, Zhu Xiaojie uses low-accuracy location to keep the task connected. Location data is never stored or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 执行期间使用低精度定位维持任务连接；位置数据不会保存或上传。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
